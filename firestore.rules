rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Matches your getHabitsStream() which uses 'createdBy'
    match /habits/{habitId} {
      allow read, write: if request.auth != null && 
                         (resource == null || resource.data.createdBy == request.auth.uid);
    }

    // 2. Matches your getHabitCompletionsStream() which uses 'userId'
    match /habitCompletions/{completionId} {
      allow read: if request.auth != null; 
      allow create: if request.auth != null && 
                    request.resource.data.userId == request.auth.uid;
    }

    // 3. User Stats protection
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 4. Habit Groups - allow members to read, creators to write
    match /habitGroups/{groupId} {
      // Allow read if user is creator OR member OR group is public
      allow read: if request.auth != null && 
        (resource.data.createdBy == request.auth.uid ||
         request.auth.uid in resource.data.members ||
         resource.data.status == 'onTrack');
      
      // Allow create if authenticated and sets own userId
      allow create: if request.auth != null && 
        request.resource.data.createdBy == request.auth.uid;
      
      // Allow update/delete only if creator
      allow update, delete: if request.auth != null && 
        resource.data.createdBy == request.auth.uid;
    }
  }
}
