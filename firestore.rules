rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // ==================== HABITS RULES ====================
    match /habits/{habitId} {
      // Allow read if user owns the habit
      allow read: if isOwner(resource.data.createdBy);
      
      // Allow create if user is authenticated and sets their own userId
      allow create: if isAuthenticated() 
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      
      // Allow update if user owns the habit
      allow update: if isOwner(resource.data.createdBy)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      
      // Allow delete if user owns the habit
      allow delete: if isOwner(resource.data.createdBy);
    }
    
    // ==================== HABIT GROUPS RULES ====================
    match /habitGroups/{groupId} {
      // Allow read if user owns the group OR group is public (status == 'onTrack')
      allow read: if isOwner(resource.data.createdBy) 
        || resource.data.status == 'onTrack';
      
      // Allow create if user is authenticated and sets their own userId
      allow create: if isAuthenticated() 
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      
      // Allow update if user owns the group
      allow update: if isOwner(resource.data.createdBy)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      
      // Allow delete if user owns the group
      allow delete: if isOwner(resource.data.createdBy);
    }
    
    // ==================== HABIT COMPLETIONS RULES ====================
    match /habitCompletions/{completionId} {
      // Allow read if user owns the completion
      allow read: if isOwner(resource.data.userId);
      
      // Allow create if user is authenticated and sets their own userId
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time;
      
      // Allow update if user owns the completion
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt;
      
      // Allow delete if user owns the completion
      allow delete: if isOwner(resource.data.userId);
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

